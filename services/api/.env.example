# Copy to services/api/.env for local development. Never commit actual credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/zhangqing
DEMO_MODE=true
OCR_MODEL_ROOT=/home/USER/.cache/zhangqing-ai/ocr-models
# DeepSeek OpenAI-compatible API. Enter the key and base URL in services/api/.env.
# The base URL may be the service base (for example https://api.deepseek.com) or a full chat/completions URL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
